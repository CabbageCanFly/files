{
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "C:/Users/James/.claude/notifications/claude-notify.js",
              "--hook"
            ],
            "timeout": 25
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "C:/Users/James/.claude/notifications/claude-notify.js",
              "--hook"
            ],
            "timeout": 25
          },
          {
            "type": "command",
            "command": "C:/Users/James/AppData/Local/Programs/Python/Python314/python.exe",
            "args": [
              "C:/Users/James/.claude/notifications/notify-toast.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"C:/Users/James/.claude/statusline-command.js\""
  },
  "modelSettings": {
    "claude-haiku-5-5": {
      "effortLevel": "low"
    }
  },
  "autoUpdatesChannel": "latest",
  "model": "haiku"
}
